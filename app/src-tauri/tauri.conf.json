{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Oops",
  "mainBinaryName": "Oops",
  "version": "1.0.2",
  "identifier": "tech.nadav.oops",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "nsis"
    ],
    "category": "Utility",
    "publisher": "nadav.tech_",
    "copyright": "© 2026 nadav.tech_ · MIT License",
    "homepage": "https://nadavm-ux.github.io/oops/",
    "shortDescription": "Fix text typed in the wrong keyboard language",
    "longDescription": "Typed akuo instead of שלום? Press Alt+O and Oops retypes it in the right language (English ↔ Hebrew). No AI, no internet, nothing stored.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": {
          "width": 640,
          "height": 420
        },
        "appPosition": {
          "x": 160,
          "y": 200
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 200
        }
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "Hebrew"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "nsis/header.bmp",
        "sidebarImage": "nsis/sidebar.bmp"
      }
    }
  }
}
